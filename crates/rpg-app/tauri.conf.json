{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rpg",
  "identifier": "dev.rpg.tray",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "capabilities": [
        "overlay",
        "settings"
      ]
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdERTdEREI2QTJDRjlCQjYKUldTMm04K2l0dDNuZlRoam1TODYxSVphRnlHc0tyei9iQ1ZNaVpsRW5SS3FRTGJOOHlZMEwvL1MK",
      "endpoints": [
        "https://github.com/waterfausett/rpg/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
