{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rpg",
  "version": "0.1.0",
  "identifier": "dev.rpg.tray",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "capabilities": [
        "overlay"
      ]
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
